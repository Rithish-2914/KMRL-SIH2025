# Database & Cache
DATABASE_URL="postgresql://kmrl_user:your_password@localhost:5432/kmrl_documents"
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-secure-secret-here-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI & Cloud API Keys (Do NOT commit real keys)
GOOGLE_VISION_API_KEY="your-google-vision-api-key"
GOOGLE_TRANSLATE_API_KEY="your-google-translate-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Integrations
WHATSAPP_API_KEY="your-whatsapp-api-key"
SHAREPOINT_CLIENT_ID="your-sharepoint-client-id"
SHAREPOINT_CLIENT_SECRET="your-sharepoint-client-secret"
